<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-Shop - Login</title>
    <link rel="stylesheet" href="/css/users/login.css">
    <%- include("../partials/styles.ejs") %>
</head>
<body>
    <% if(error) { %>
        <div class="error-message">
            <p><%= error %></p>
        </div>
    <% } %>
    <div class="login-container">
        <h3>Login</h3>
        <p class="login-subtitle">Welcome back! Please login to your account.</p>
        <form method="post" action="/users/verify" class="login-form">
            <div class="user-email">
                <i class="fa-regular fa-envelope"></i>
                <input type="email" name="email" placeholder="Email address">
            </div>
            <div class="user-password">
                <i class="fa-solid fa-lock"></i>
                <input type="password" name="password" placeholder="Password" class="password">
                <i class="fa-solid fa-eye eye"></i>
            </div>
            <div class="login-btn">
                <button>Login</button>
            </div>
        </form>
        <p class="signup-text">Don't have an account? <a href="/users/signup" class="user-signup">Sign Up</a></p>
    </div>
    <%- include("../partials/scripts.ejs") %>
</body>
</html>