<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-Shop - Products</title>
    <%- include("../partials/styles.ejs") %>
    <link rel="stylesheet" href="/css/products/index.css">
</head>
<body>
    <%- include("../partials/navbar.ejs") %>
    <main>
        <section class="products">
            <h2>Products</h2>

            <div class="category-links">
                <h3>Category:</h3>
                <form method="get" action="/products">
                    <button class="<%= !category ? 'active' : '' %>">All</button>
                </form>
                <form method="get" action="/products">
                    <input type="hidden" name="category" value="Electronics">
                    <button class="<%= category === 'Electronics' ? 'active' : '' %>">Electronics</button>
                </form>
                <form method="get" action="/products">
                    <input type="hidden" name="category" value="Clothing">
                    <button class="<%= category === 'Clothing' ? 'active' : '' %>">Clothing</button>
                </form>
                <form method="get" action="/products">
                    <input type="hidden" name="category" value="Shoes">
                    <button class="<%= category === 'Shoes' ? 'active' : '' %>">Shoes</button>
                </form>
                <form method="get" action="/products">
                    <input type="hidden" name="category" value="Books">
                    <button class="<%= category === 'Books' ? 'active' : '' %>">Books</button>
                </form>
                <form method="get" action="/products">
                    <input type="hidden" name="category" value="Accessories">
                    <button class="<%= category === 'Accessories' ? 'active' : '' %>">Accessories</button>
                </form>
            </div>

            <div class="product-container">
            <% for(let product of products) { %>
                <div class="product-card">
                    <div class="product-image">
                        <img src="<%= product.image %>" alt="Product IMG">
                    </div>
                    <div class="product-details">
                        <h3 class="product-title"><%= product.name %></h3>
                        <p class="product-price">&#8377;<%= product.price.toLocaleString('en-IN') %></p>
                        <form class="product-btn" method="get" action="/products/<%= product._id %>">
                            <button class="view-btn">View Product</button>
                        </form>
                    </div>
                </div>
            <% } %>
        </div>
        </section>
    </main>
    <%- include("../partials/footer.ejs") %>
</body>
</html>